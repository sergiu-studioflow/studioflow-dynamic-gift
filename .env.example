# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Better Auth ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-here-min-32-chars        # openssl rand -base64 32
BETTER_AUTH_URL=https://your-portal.vercel.app          # production URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-portal.vercel.app      # same as BETTER_AUTH_URL

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=noreply@studio-flow.co   # optional, defaults to onboarding@resend.dev
# RESEND_FROM_NAME=StudioFlow                # optional, set to brand name for white-labeling

# ─── n8n Webhooks ─────────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-shared-secret-between-n8n-and-portal

# ─── n8n Instance (optional) ──────────────────────────────────────────────────
# N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# ─── AI / Generation keys (also settable per-client in Settings → API Keys) ───
KIE_AI_API_KEY=                 # Kie AI — review graphic generation (Nano Banana 2)
ANTHROPIC_API_KEY=              # Claude — review caption generation
APIFY_TOKEN=                    # Apify — Google Maps reviews scraper (Review Scraping System)

# ─── Cloudflare R2 (asset storage) ────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studioflow-assets
R2_PUBLIC_URL=https://pub-c85814e28869441d8a619b3b90562166.r2.dev
BRAND_SLUG=dynamic-gift         # set via `printf`, never `echo` (trailing \n corrupts R2 paths)

# ─── Cron (Review Scraping System) ────────────────────────────────────────────
# Vercel injects this as a Bearer token on scheduled cron requests; the cron
# routes (/api/cron/*) require it. Generate with: openssl rand -hex 32
CRON_SECRET=
